# Copy this file to .env and set your own values. .env is git-ignored.
# POSTGRES_PASSWORD and JWT_SECRET are deliberately empty: Docker Compose refuses to start until you fill them in,
# so a known placeholder can never protect a real database or sign real tokens.
POSTGRES_DB=chapelbook
POSTGRES_USER=chapelbook
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional: creates the first admin at startup if no admin exists yet. Leave empty to skip.
# The password needs at least 8 characters. Sign in, create your librarians, then you may remove these two lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Full stack (docker compose up -d --build): where the web app is served on this machine.
WEB_PORT=8081
# Set to false to switch off the API description and Swagger UI.
SPRINGDOC_ENABLED=true

# Only when you run the backend yourself with ./mvnw spring-boot:run (Compose sets these for its own backend).
# DB_PASSWORD must match POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5433/chapelbook
DB_USERNAME=chapelbook
DB_PASSWORD=
