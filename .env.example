# Copy this file to .env and set your own values. .env is git-ignored.
# POSTGRES_PASSWORD is deliberately empty: Docker Compose refuses to start until you fill it in,
# so a known placeholder can never protect a real database.
POSTGRES_DB=chapelbook
POSTGRES_USER=chapelbook
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Backend (when running it directly with ./mvnw spring-boot:run). The password must match POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5433/chapelbook
DB_USERNAME=chapelbook
DB_PASSWORD=
# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional: creates the first admin at startup if no admin exists yet. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
